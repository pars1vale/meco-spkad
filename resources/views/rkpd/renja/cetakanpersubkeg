/* ===================== RENDER HELPERS ===================== */
function formatRupiah(n){
  if (n === undefined || n === null || n === "") return "";
  const num = Number(n);
  return "Rp. " + num.toLocaleString("id-ID", {minimumFractionDigits:2, maximumFractionDigits:2});
}
function valueHtml(v){
  if (Array.isArray(v)) return v.map(l => `<span class="line">${l}</span>`).join("");
  return v;
}
function renderFieldTable(tbodyId, rows){
  const tbody = document.getElementById(tbodyId);
  rows.forEach(([label, value]) => {
    const tr = document.createElement("tr");
    tr.innerHTML = `<td class="label">${label}</td><td class="value">: ${valueHtml(value)}</td>`;
    tbody.appendChild(tr);
  });
}
function renderKinerja(){
  const tbody = document.getElementById("kinerja-body");
  DATA.kinerja.forEach(([ind, tolok, target]) => {
    const tr = document.createElement("tr");
    tr.innerHTML = `<td>${ind}</td><td>${tolok}</td><td>${target}</td>`;
    tbody.appendChild(tr);
  });
}

function renderRincian(){
  const tbody = document.getElementById("rincian-body");
  let grandTotal = 0;

  DATA.rincianHeader.forEach(row => {
    const tr = document.createElement("tr");
    tr.className = "header-row";
    tr.innerHTML = `
      <td>${row.kode}</td>
      <td colspan="5">${row.uraian}</td>
      <td class="num">${formatRupiah(row.jumlah)}</td>
    `;
    tbody.appendChild(tr);
  });

  DATA.rincian.forEach(row => {
    const g = document.createElement("tr");
    g.className = "group-row";
    g.innerHTML = `
      <td></td>
      <td colspan="5"><span class="grp-title">[ # ] ${row.group}</span><br><span class="grp-sumber">Sumber Dana : ${row.sumberDana}</span></td>
      <td class="num">${formatRupiah(row.jumlah)}</td>
    `;
    tbody.appendChild(g);

    row.items.forEach(it => {
      if (it.subLabel){
        const s = document.createElement("tr");
        s.className = "sub-row";
        s.innerHTML = `
          <td></td>
          <td colspan="5">[ - ] ${it.subLabel}</td>
          <td class="num">${formatRupiah(it.subJumlah)}</td>
        `;
        tbody.appendChild(s);
      }
      const tr = document.createElement("tr");
      tr.className = "detail-row";
      tr.innerHTML = `
        <td></td>
        <td>${it.uraian}<br><span class="spesifikasi">Spesifikasi : ${it.spesifikasi || "-"}</span></td>
        <td class="center">${it.koefisien || ""}</td>
        <td class="center">${it.satuan || ""}</td>
        <td class="num">${formatRupiah(it.harga)}</td>
        <td class="center">${it.ppn || 0} %</td>
        <td class="num">${formatRupiah(it.jumlah)}</td>
      `;
      tbody.appendChild(tr);
      grandTotal += Number(it.jumlah || 0);
    });
  });

  const totalRow = document.createElement("tr");
  totalRow.className = "total-row";
  totalRow.innerHTML = `<td colspan="6" style="text-align:right;">Jumlah :</td><td class="num">${formatRupiah(grandTotal)}</td>`;
  tbody.appendChild(totalRow);
}

function renderTtd(){
  document.getElementById("ttd-tempat-tanggal").textContent = `${DATA.ttd.tempat},${DATA.ttd.tanggal}`;
  document.getElementById("ttd-jabatan").textContent = DATA.ttd.jabatan;
  document.getElementById("ttd-nama").textContent = DATA.ttd.nama;
  document.getElementById("ttd-nip").textContent = `NIP. ${DATA.ttd.nip}`;
}

